# ==============================================================================
# TrustFlow SDK Environment Configuration Template
# ==============================================================================
# NOTE: The SDK itself does not automatically read or load process.env.
# Load these variables using `dotenv` (npm i dotenv), your application framework
# (Next.js / Vite / Nuxt), or via shell exports (export VAR=value).
#
# These variables correspond to the configurations referenced throughout
# docs/QUICKSTART.md, docs/API.md, and examples/*.
# ==============================================================================

# --- Stellar Network & Smart Contract ---
# Soroban contract address for TrustFlow escrow (starts with C...)
TRUSTFLOW_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4
# Legacy alias referenced in docs/API.md snippets
CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4
# Stellar network identifier: TESTNET, MAINNET, or LOCAL
STELLAR_NETWORK=TESTNET
# Soroban RPC URL for transaction simulation and submission
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Stellar Horizon server URL for account sequence and balance queries
HORIZON_URL=https://horizon-testnet.stellar.org
# Optional custom token contract address (e.g. USDC contract ID)
USDC_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
# Caller Stellar public key (G...) used by examples/create-escrow.ts, release-funds.ts, and dispute.ts
STELLAR_PUBLIC_KEY=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAWHF
# Beneficiary/recipient Stellar public key (G...) used by examples/create-escrow.ts
RECIPIENT_ADDRESS=GBRPYHIL2CI3FNQ4BXLFMNDLFJUNPU2HY3ZMFDAGORAC526G22TYOXA2
# JSON array of base64-encoded ScSpecEntry strings for contract binding generation (docs/CONTRACT_BINDINGS.md)
TRUSTFLOW_SPEC_ENTRIES=[]

# --- TrustFlow Backend API & Authentication ---
# Base URL for the TrustFlow off-chain indexing and profile API
TRUSTFLOW_API_URL=http://localhost:3001
# API key or bearer auth token for backend client requests
AUTH_TOKEN=your_backend_auth_token_here
API_KEY=your_api_key_here
# Bearer token injected by request interceptors in examples/interceptors.ts
TRUSTFLOW_API_TOKEN=your_trustflow_api_token_here

# --- Decentralized Storage (IPFS) ---
# Pinata or IPFS gateway API key for evidence and milestone file uploads
IPFS_API_KEY=your_ipfs_api_key_here

# --- Multi-Signature Escrow Workflows (examples/multisig-escrow.ts) ---
# Raw XDR envelopes used in multi-party signing workflows
UNSIGNED_RELEASE_XDR=
SIGNED_XDR_A=
SIGNED_XDR_B=
